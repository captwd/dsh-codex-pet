{
  "name": "dsh-pet-quota-desktop",
  "version": "1.0.0",
  "private": false,
  "description": "DSH 小 DS 伴宠：DeepSeek 余额 + GPT 5h/周额度面板、任务卡片，可选桌面独立悬浮窗 / Small DS companion with balance and quota batteries for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "desktop",
    "src",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@linxin666/dsh-pet": ">=0.4.8"
  },
  "peerDependenciesMeta": {
    "@linxin666/dsh-pet": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install-desktop": "node scripts/install-desktop.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
